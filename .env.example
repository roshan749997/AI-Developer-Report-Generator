# =============================================================================
# Root environment template — copy to backend/.env for local development
# =============================================================================

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/developer-report-generator?retryWrites=true&w=majority

# Logging
LOG_LEVEL=info

# Rate limiting (optional baseline)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth / JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN_MS=3600000

# Git Scanner
GIT_SCAN_MAX_COMMITS=200
GIT_SCAN_MAX_DIFF_CHARS=200000

# AI Engine (OpenAI — legacy; Phase 6 uses Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PREVIOUS_REPORTS_LIMIT=5
AI_MAX_COMMITS_PER_REPORT=50
AI_DIFF_EXCERPT_CHARS=4000

# AI Engine (Google Gemini — daily Reports)
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyDqth7r9-hBKo_YwB8WgrRrQ7SYvUU2YFA
GEMINI_MODEL=gemini-2.5-flash

# Daily report scheduler (8:00 PM Asia/Kolkata)
DAILY_REPORT_SCHEDULER_ENABLED=true
DAILY_REPORT_CRON=0 20 * * *
DAILY_REPORT_TIMEZONE=Asia/Kolkata

# SMTP email delivery (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Developer Report Generator <noreply@example.com>"
